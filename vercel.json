{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://ready2cop-server.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://ready2cop-server.onrender.com/uploads/:path*" },
    { "source": "/((?!assets/|uploads/).*)", "destination": "/index.html" }
  ]
}
